# Spotify Developer Credentials
# Create a free app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# Default Playlists (Optional - can also pass via CLI flags)
SPOTIFY_PLAYLIST_ID=https://open.spotify.com/playlist/...
YTMUSIC_PLAYLIST_ID=https://music.youtube.com/playlist?list=...
